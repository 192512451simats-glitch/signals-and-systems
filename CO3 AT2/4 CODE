clc;
clear;
close;

// Time step
dt = 0.001;

// Time vector
t = 0:dt:5;

// Input x(t) = exp(-2t)u(t)
x = exp(-2*t);

// Impulse response h(t) = exp(-3t)u(t)
h = exp(-3*t);

// Convolution
y_conv = convol(x, h);

// Scale by dt
y_conv = y_conv * dt;

// Time vector for convolution output
t_conv = 0:dt:(length(y_conv)-1)*dt;

// Analytical result
// y(t) = exp(-2t) - exp(-3t)
y_analytical = exp(-2*t) - exp(-3*t);

// Plot all three
clf();

subplot(3,1,1);
plot(t, x);
xlabel("Time (s)");
ylabel("x(t)");
title("Input Signal x(t) = exp(-2t)");
xgrid();

subplot(3,1,2);
plot(t, h);
xlabel("Time (s)");
ylabel("h(t)");
title("Impulse Response h(t) = exp(-3t)");
xgrid();

subplot(3,1,3);
plot(t_conv, y_conv);
plot(t, y_analytical, "r--");
xlabel("Time (s)");
ylabel("y(t)");
title("Convolution Output");
legend("Numerical Convolution", "Analytical Result");
xgrid();
